{
  "name": "terraside",
  "productName": "Terraside",
  "version": "1.0.0",
  "description": "A modern desktop media reader.",
  "author": "briank02",
  "private": true,
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run typecheck && vite build && electron-builder --config electron-builder.json5",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx,mts --report-unused-disable-directives --max-warnings 0",
    "test": "tsc --project tsconfig.test.json && node --test .test-dist/tests/core-utils.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
